# Copy to .env and fill in. Every value can also be passed to `new HashnodeClient({...})`.

# Required: your publication host (Hashnode subdomain or custom domain).
# The publication must be on a Hashnode Pro plan for API access.
HASHNODE_PUBLICATION_HOST=yourblog.hashnode.dev

# Optional: publication ID. Saves one lookup before the first search.
# HASHNODE_PUBLICATION_ID=

# Optional: personal access token (Hashnode → Account Settings → Developer).
# Required only for drafts.
# HASHNODE_ACCESS_TOKEN=

# Optional: webhook secret from Hashnode → Blog Dashboard → Webhooks.
# Used by createWebhookHandler().
# HASHNODE_WEBHOOK_SECRET=

# Optional: override the GraphQL endpoint (default https://gql-beta.hashnode.com/).
# HASHNODE_API_URL=

# Optional: request timeout in milliseconds (default 15000).
# HASHNODE_TIMEOUT_MS=
