{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@jowinjohnchemban/hashnode-client": ["./src/index.ts"],
      "@jowinjohnchemban/hashnode-client/webhooks": ["./src/webhooks.ts"]
    }
  },
  "include": ["src", "test", "examples", "*.config.ts"]
}
